# Copy to .env.local for local dev; set the same names as environment
# variables in your host (Vercel, Netlify, …) for deployments.

# ---- Supabase (required) ----------------------------------------------------
# Supabase → Connect (or Settings → API Keys). Both are safe to expose:
# row-level security in supabase/migrations decides what each user can see.
# Use the publishable key (sb_publishable_…); Supabase is retiring the legacy
# "anon" key. Never put the secret / service_role key here — the app doesn't
# need it. Step-by-step: docs/setup.md.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ---- Branding (inlined at build time) --------------------------------------
NEXT_PUBLIC_APP_NAME="LinkedIn Analytics Tracker"
NEXT_PUBLIC_APP_SHORT_NAME="LI Tracker"
NEXT_PUBLIC_APP_DESCRIPTION="Track your team's LinkedIn reach and growth over time."
# Path under /public or an absolute URL.
NEXT_PUBLIC_LOGO_URL=/logo.svg

# Timezone for tracking-period and deadline math (IANA name). Defaults to UTC.
APP_TIMEZONE=UTC

# ---- Experimental LinkedIn API (needs LinkedIn partner approval) -----------
# See docs/linkedin-member-analytics-setup.md. Leave off otherwise.
LINKEDIN_API_ENABLED=false
NEXT_PUBLIC_FEATURE_LINKEDIN_API=false
